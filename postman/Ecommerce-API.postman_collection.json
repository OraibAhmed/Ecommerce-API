{
  "info": {
    "name": "Ecommerce API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    { "name": "1. Get all products", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }},
    { "name": "2. Get an existing product", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] } }},
    { "name": "3. Get a non-existing product", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/products/999999", "host": ["{{baseUrl}}"], "path": ["api", "products", "999999"] } }},
    { "name": "4. Create a valid product", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"category_id\": 1, \"name\": \"Valid Product\", \"price\": 100, \"stock_quantity\": 10, \"sku\": \"VALID-1\"}" }, "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }},
    { "name": "5. Create a product without a name", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"category_id\": 1, \"price\": 100, \"stock_quantity\": 10, \"sku\": \"INVALID-NAME\"}" }, "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }},
    { "name": "6. Create a product with a negative price", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"category_id\": 1, \"name\": \"Negative Price\", \"price\": -5, \"stock_quantity\": 10, \"sku\": \"NEG-PRICE\"}" }, "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }},
    { "name": "7. Create a product with negative stock", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"category_id\": 1, \"name\": \"Negative Stock\", \"price\": 10, \"stock_quantity\": -5, \"sku\": \"NEG-STOCK\"}" }, "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }},
    { "name": "8. Create a product with a duplicate SKU", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"category_id\": 1, \"name\": \"Duplicate SKU\", \"price\": 10, \"stock_quantity\": 5, \"sku\": \"VALID-1\"}" }, "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] } }},
    { "name": "9. Update an existing product", "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"category_id\": 1, \"name\": \"Updated Product\", \"price\": 150, \"stock_quantity\": 20, \"sku\": \"VALID-1-UPDATED\"}" }, "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] } }},
    { "name": "10. Update a non-existing product", "request": { "method": "PUT", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"category_id\": 1, \"name\": \"Update Fail\", \"price\": 150, \"stock_quantity\": 20, \"sku\": \"XXX\"}" }, "url": { "raw": "{{baseUrl}}/api/products/999999", "host": ["{{baseUrl}}"], "path": ["api", "products", "999999"] } }},
    { "name": "11. Deactivate a product", "request": { "method": "PATCH", "url": { "raw": "{{baseUrl}}/api/products/1/deactivate", "host": ["{{baseUrl}}"], "path": ["api", "products", "1", "deactivate"] } }},
    { "name": "12. Create a valid category", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"name\": \"Valid Category\", \"description\": \"Test\"}" }, "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] } }},
    { "name": "13. Create a valid user", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"full_name\": \"John Doe\", \"email\": \"johndoe@example.com\"}" }, "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] } }},
    { "name": "14. Create a user with a duplicate email", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"full_name\": \"John Doe 2\", \"email\": \"johndoe@example.com\"}" }, "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] } }},
    { "name": "15. Send incomplete JSON", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": { "mode": "raw", "raw": "{\"full_name\": \"Only Name\"}" }, "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] } }},
    { "name": "16. Request an unknown API route", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/unknown-route", "host": ["{{baseUrl}}"], "path": ["api", "unknown-route"] } }}
  ]
}
